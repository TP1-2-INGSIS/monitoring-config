# =============================================================================
# Variables de entorno de New Relic — EJEMPLO
# =============================================================================
# Copiá este archivo a `.env` (que está gitignorado) y completá los valores.
# La license key es un SECRETO: nunca la comitees. En CI/CD se inyecta como
# secret del pipeline (GitHub Actions secret), igual que la credencial de Azure.
# =============================================================================

# Secreto. Lo obtenés en: New Relic -> API keys -> Ingest - License.
NEW_RELIC_LICENSE_KEY=your-license-key-here

# Nombre del servicio tal como aparecerá en New Relic. DISTINTO por servicio.
# Es lo que separa cada microservicio en la UI de APM.
NEW_RELIC_APP_NAME=assets

# Opcional: entorno lógico (production | staging | development | test).
# Selecciona el bloque correspondiente del newrelic.yml.
NEW_RELIC_ENVIRONMENT=production
